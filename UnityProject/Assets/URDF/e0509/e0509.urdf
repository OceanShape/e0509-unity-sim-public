<?xml version="1.0" ?>
<!-- e0509 Unity 시뮬레이터용 URDF. scripts/make_unity_urdf.py 가 만든다. 손으로 고치지 말 것. -->
<!-- 원천: ~/strawberry_grasp_environment/robot.urdf (Isaac 용 URDF) -->
<!--   딸기 리포 HEAD 2797bb5 · robot.urdf 마지막 커밋 a2e9bb5 · sha256 31518983405e61b26012fbc9ab3472b4c797590a3fe4a0ffbf3af9d471965a01 -->
<!--   메쉬 저장소 src/doosan_robot2 @ ec92425 -->
<!--   메쉬 저장소 src/RH-P12-RN @ 58d06e7 -->
<!-- 원천 대비 바꾼 것: 메쉬 절대 경로 → package:// : 40곳 / 중복 world 링크 + world_fixed(→ rh_p12_rn_base) 삭제: 1곳 / rh_r2 upper 1.0 → 1.1 rad / rh_l2 upper 1.0 → 1.1 rad / ros2_control 블록 삭제: 1개 / transmission 블록 삭제: 10개 / gazebo 블록 삭제: 15개 -->
<robot name="strawberry_grasp_environment_robot">
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>
