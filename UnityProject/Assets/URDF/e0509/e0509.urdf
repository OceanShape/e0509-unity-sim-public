    </inertial>
  </link>
  <!-- Left Joint 2 -->
  <joint name="rh_l2" type="revolute">
    <parent link="rh_p12_rn_l1"/>
    <child link="rh_p12_rn_l2"/>
    <origin rpy="0 0 0" xyz="0.0 -0.0493634 0.0285"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="0.0" upper="1.1" velocity="6.5"/>
    <dynamics damping="0.7"/>
  </joint>
  <!-- rh_p12_rn_l2 -->
  <link name="rh_p12_rn_l2">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rh_p12_rn_description/meshes/l2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rh_p12_rn_description/meshes/l2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0.000 -0.006 0.011"/>
      <mass value="0.022"/>
      <!--<inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.0" />-->
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>
  <!-- Joint connecting arm to gripper -->
  <!-- The z offset and rotation should be adjusted based on the real hardware mount -->
  <joint name="arm_to_gripper" type="fixed">
    <parent link="link_6"/>
    <child link="rh_p12_rn_base"/>
    <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ========================================== -->
  <!-- 3. Custom 3D Printed Gripper Parts -->
  <!-- ========================================== -->
  <!-- 
    The user can modify these origins and collision primitives later. 
    The stl file is assumed to be in strawberry_grasp_environment_description/meshes/gripper_parts.stl
  -->
  <!-- Left Custom Part -->
  <link name="left_custom_part">
    <inertial>
      <mass value="0.1"/>
      <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <!-- Replace this with the correct mesh if it's mirrored, or use scale="-1 1 1" etc. -->
        <mesh filename="package://strawberry_grasp_environment_description/meshes/gripper_parts.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>
  <joint name="l2_to_left_custom_part" type="fixed">
    <parent link="rh_p12_rn_l2"/>
    <child link="left_custom_part"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0.02090 0.00498 0.00058"/>
  </joint>
  <!-- Right Custom Part -->
  <link name="right_custom_part">
    <inertial>
      <mass value="0.1"/>
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <!-- Using the same mesh. You might need to flip it if it's asymmetrical -->
        0
        
        <mesh filename="package://strawberry_grasp_environment_description/meshes/gripper_parts.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>
  <joint name="r2_to_right_custom_part" type="fixed">
    <parent link="rh_p12_rn_r2"/>
    <child link="right_custom_part"/>
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="-0.02090 -0.00499 0.00058"/>
  </joint>
</robot>
