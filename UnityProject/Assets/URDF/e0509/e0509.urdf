    <color rgba="0.490 0.490 0.486 1.0"/>
  </material>
  <material name="dr_white">
    <color rgba="0.941 0.941 0.941 1.0"/>
  </material>
  <material name="dr_blue">
    <color rgba="0 0 0.15 1"/>
  </material>
  <link name="base_link">
    <inertial>
      <mass value="1.803"/>
      <origin xyz="2.7e-05   -0.002651    0.035122"/>
      <inertia ixx="0.010608" ixy="1.7706e-06" ixz="6.6982e-06" iyy="0.0092656" iyz="-4.7833e-05" izz="0.0092125"/>
