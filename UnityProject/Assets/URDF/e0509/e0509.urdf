      <origin xyz="0.18647 -1.1418e-17     0.17311"/>
      <inertia ixx="0.012039" ixy="7.7771e-06" ixz="3.7559e-06" iyy="0.091203" iyz="3.1825e-06" izz="0.094721"/>
